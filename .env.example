# Copy thành .env, không commit .env
ENV=local

# Database / Supabase
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/book_review
# Test RLS/integration: kết nối quản trị, mỗi lần chạy test tạo rồi xoá một database riêng.
TEST_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/postgres
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Project mới (ES256/JWKS): chỉ cần SUPABASE_URL, để trống SUPABASE_JWT_SECRET.
# Project cũ (HS256) mới điền JWT secret.
SUPABASE_JWT_SECRET=

# Queue
REDIS_URL=redis://localhost:6379/0

# Providers
GOOGLE_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
FAL_KEY=

# Observability
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=book-review-local

# CopilotKit runtime (web)
AGENT_URL=http://localhost:8000/agent
COPILOTKIT_TELEMETRY_DISABLED=true
