# Copy thành .env, không commit .env
ENV=local

# Database / Supabase
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/book_review
# Test RLS/integration: kết nối quản trị, mỗi lần chạy test tạo rồi xoá một database riêng.
TEST_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/postgres
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Project mới (ES256/JWKS): chỉ cần SUPABASE_URL, để trống SUPABASE_JWT_SECRET.
# Project cũ (HS256) mới điền JWT secret.
SUPABASE_JWT_SECRET=

# Queue
REDIS_URL=redis://localhost:6379/0
# Thư mục media dùng chung giữa API và worker
MEDIA_DIR=var/media
TTS_VOICE=vi-VN-HoaiMyNeural

# Providers
GOOGLE_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
# Giám khảo faithfulness, phải khác GEMINI_MODEL (ngày 11)
JUDGE_MODEL=gemini-3.1-flash-lite
# Tìm web: gemini (Google Search grounding) hoặc tavily
SEARCH_PROVIDER=gemini
TAVILY_API_KEY=
# Retrieval: top-k sau khi gộp vector + full-text, số chunk sau rerank, "none" hoặc "llm"
RETRIEVE_TOP_K=8
RERANK_TOP_N=4
RERANK_PROVIDER=none
EMBEDDING_MODEL=gemini-embedding-001
# Phải khớp cột vector(N) trong db/migrations/0004_vector_store.sql
EMBEDDING_DIM=768
FAL_KEY=

# Observability
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=book-review-local

# Web (apps/web, đặt trong apps/web/.env.local). Khoá anon là khoá công khai của Supabase.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# FastAPI mà route proxy `/api/backend/*` của web chuyển tiếp tới
API_URL=http://localhost:8000

# CopilotKit runtime (spike ngày 2, chưa dùng ở màn chính)
AGENT_URL=http://localhost:8000/agent
COPILOTKIT_TELEMETRY_DISABLED=true
